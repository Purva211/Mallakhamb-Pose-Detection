# ==============================================================================
# Mallakhamb Chatbot Environment Variables Configuration
# ==============================================================================

# --- Backend Configuration ---
# Port on which the FastAPI backend will run
BACKEND_PORT=5000

# Groq API Configuration
# Get your API key from the Groq console: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# --- Frontend Configuration ---
# API URL that the frontend will query (FastAPI server endpoint)
VITE_API_URL=http://localhost:5000/api
